{
  "mcpServers": {
    "Numera-CHA-Solver-MCP": {
      "command": "/absolute/path/to/numera-cha-solver/bin/numera-cha-solver-mcp",
      "args": ["bridge"],
      "env": {
        "NUMERA_ROOT": "/absolute/path/to/numera-cha-solver",
        "NUMERA_MCP_PORT": "1583",
        "NUMERA_DEVICE": "cpu"
      }
    }
  }
}
