{
  "mcpServers": {
    "Numera-CHA-Solver-MCP": {
      "type": "stdio",
      "command": "${env:NUMERA_MCP_COMMAND}",
      "args": ["bridge"],
      "env": {
        "NUMERA_ROOT": "${env:NUMERA_ROOT}",
        "NUMERA_MCP_PORT": "1583",
        "NUMERA_DEVICE": "${env:NUMERA_DEVICE}"
      }
    }
  }
}
