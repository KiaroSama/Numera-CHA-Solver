{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Numera CHA-Solver",
  "version": "0.4.1",
  "identifier": "dev.numera.cha-solver",
  "build": {
    "frontendDist": "../resources/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["embedded-workspace"],
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "shortDescription": "Local perception with explicit human review",
    "longDescription": "Owner-controlled local recognition and human assistance. No third-party submission or verified CAPTCHA accuracy claim.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/numera-cha"],
    "resources": {
      "generated/resources/": ""
    },
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
      "signCommand": {"cmd": "pwsh", "args": ["-NoProfile", "-File", "../scripts/sign_release.ps1", "-Phase", "Native", "-Path", "%1"]}
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
